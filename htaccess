# ---- Racine du site Beauty ----

# Pas de liste des fichiers quand un dossier n'a pas d'index
Options -Indexes

# Forcer HTTPS en ligne (ne s'applique pas en local sur localhost)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Bloquer les fichiers cachés (.git, .env, .gitignore...) et les fichiers sensibles
<FilesMatch "^\.|\.(sql|md|log|ini|example\.php)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# En-têtes de sécurité de base
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
